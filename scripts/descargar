#!/usr/bin/env bash
# descargar — baja música a SpaceMusic sin repetir canciones.
#
#   descargar "https://open.spotify.com/track|album|playlist|artist/..."   (Spotify)
#   descargar "https://www.youtube.com/watch?v=..."  "https://soundcloud.com/..."   (YouTube, YouTube Music, SoundCloud y más)
#   descargar "Artista - Canción"                                            (búsqueda por nombre)
#   Se pueden pasar varios enlaces a la vez.
#
# - No repite: recuerda lo ya descargado (archivo de historial) y salta lo que ya existe.
# - Si algo falla, lo reintenta solo (hasta 3 rondas, esperando entre una y otra).
# - Credenciales propias de Spotify (opcional, mucho más rápido y sin bloqueos):
#     guarda CLIENT_ID y CLIENT_SECRET en ~/.config/spacemusic/spotify.env
set -uo pipefail

BASE=/home/admin123/spacemusic
DESTINO=$BASE/musica/Descargas
ENV=$BASE/spotdl-env/bin
DATOS=$HOME/.config/spacemusic
HISTORIAL=$DATOS/descargadas-spotify.txt
HISTORIAL_YT=$DATOS/descargadas-otras.txt
RONDAS=3
mkdir -p "$DESTINO" "$DATOS"

verde() { printf '\033[1;32m%s\033[0m\n' "$*"; }
amarillo() { printf '\033[1;33m%s\033[0m\n' "$*"; }
rojo() { printf '\033[1;31m%s\033[0m\n' "$*"; }

# Desde el .bat llega todo en un solo texto: si son varios enlaces separados por espacios, se separan
if [ $# -eq 1 ] && [[ "$1" =~ ^https?:// ]] && [[ "$1" == *" "* ]]; then
  read -ra PARTES <<< "$1"
  set -- "${PARTES[@]}"
fi

if [ $# -eq 0 ]; then
  echo "Uso: descargar \"enlace o nombre\" [más enlaces...]"
  exit 1
fi

CRED=()
if [ -f "$DATOS/spotify.env" ]; then
  # shellcheck disable=SC1091
  . "$DATOS/spotify.env"
  [ -n "${CLIENT_ID:-}" ] && [ -n "${CLIENT_SECRET:-}" ] && CRED=(--client-id "$CLIENT_ID" --client-secret "$CLIENT_SECRET")
fi

spotify() {
  "$ENV/spotdl" download "$@" \
    --output "$DESTINO/{artist}/{album}/{track-number} - {title}.{output-ext}" \
    --audio youtube --format mp3 --bitrate 320k \
    --generate-lrc --lyrics synced musixmatch genius \
    --overwrite skip --scan-for-songs --archive "$HISTORIAL" \
    --threads 4 --print-errors --save-errors "$ERRORES" \
    --yt-dlp-args "--js-runtimes node --retries 10 --fragment-retries 10 --socket-timeout 30" \
    "${CRED[@]}"
}

otra() {
  "$ENV/yt-dlp" "$1" -x --audio-format mp3 --audio-quality 0 \
    --embed-metadata --embed-thumbnail --convert-thumbnails jpg \
    --replace-in-metadata "title" '(?i)\s*[\(\[](letra|lyrics?|official[^\)\]]*|video[^\)\]]*|audio[^\)\]]*|visualizer|hd|hq|4k)[\)\]]' "" \
    --parse-metadata "%(artist,creator)s:%(artist)s" \
    --parse-metadata 'title:(?P<artist>.+?)\s+[-–]\s+(?P<title>.+)' \
    --parse-metadata "%(artist,uploader)s:%(meta_artist)s" \
    --download-archive "$HISTORIAL_YT" --no-overwrites --ignore-errors \
    --retries 10 --fragment-retries 10 --socket-timeout 30 --js-runtimes node \
    -o "$DESTINO/%(artist,uploader)s/%(title)s.%(ext)s"
}

FALLIDAS_FINAL=()
for ENTRADA in "$@"; do
  echo
  verde "▶ $ENTRADA"
  if [[ "$ENTRADA" =~ ^https?:// ]] && [[ ! "$ENTRADA" =~ spotify\.com ]]; then
    # YouTube, YouTube Music, SoundCloud, Bandcamp…
    for r in $(seq 1 $RONDAS); do
      if otra "$ENTRADA"; then break; fi
      [ "$r" -lt $RONDAS ] && { amarillo "  Falló, reintentando en 20 s ($r/$RONDAS)…"; sleep 20; }
      [ "$r" -eq $RONDAS ] && FALLIDAS_FINAL+=("$ENTRADA")
    done
    continue
  fi

  # Spotify o búsqueda por nombre
  ERRORES=$(mktemp)
  PENDIENTES=("$ENTRADA")
  for r in $(seq 1 $RONDAS); do
    : > "$ERRORES"
    spotify "${PENDIENTES[@]}"
    mapfile -t PENDIENTES < <(grep -o 'https://open.spotify.com/track/[A-Za-z0-9]*' "$ERRORES" | sort -u)
    [ ${#PENDIENTES[@]} -eq 0 ] && break
    if [ "$r" -lt $RONDAS ]; then
      ESPERA=$((r * 30))
      amarillo "  ${#PENDIENTES[@]} canciones fallaron. Reintentando en $ESPERA s (ronda $((r + 1)) de $RONDAS)…"
      sleep "$ESPERA"
    else
      FALLIDAS_FINAL+=("${PENDIENTES[@]}")
    fi
  done
  rm -f "$ERRORES"
done

echo
if [ ${#FALLIDAS_FINAL[@]} -eq 0 ]; then
  verde "✓ Todo descargado. Aparecerá en SpaceMusic en menos de un minuto."
else
  rojo "✗ No se pudieron bajar ${#FALLIDAS_FINAL[@]} canciones después de $RONDAS intentos:"
  printf '   %s\n' "${FALLIDAS_FINAL[@]}"
  echo "  Vuelve a pegar el mismo enlace más tarde: lo que ya se bajó no se repite."
  exit 2
fi
